{
  "name": "@emailens/cli",
  "version": "0.4.1",
  "description": "CLI tool for email compatibility analysis \u2014 analyze, preview, and export email rendering across 21 email clients.",
  "type": "module",
  "bin": {
    "emailens": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@emailens/engine": "^0.10.2",
    "citty": "^0.1.6",
    "cli-table3": "^0.6.5",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "playwright-core": "^1.52.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/mjml": "^4.7.4",
    "@types/node": "^25.3.0",
    "bun-types": "^1.3.9",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "email",
    "html-email",
    "css",
    "compatibility",
    "cli",
    "gmail",
    "outlook",
    "apple-mail",
    "email-testing",
    "dark-mode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emailens/cli.git"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/emailens/cli#readme",
  "bugs": {
    "url": "https://github.com/emailens/cli/issues"
  }
}
